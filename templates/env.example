# Copy this file to .env in this folder and fill in the values on your own machine.
# .env is git-ignored. Never commit it, and never paste these values into a chat.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Uncomment to use.
# DEMO_BASE_URL=
# DEMO_CHROMIUM_PATH=

# Bubble apps only, optional: the run-mode basic auth. These win over the pair saved by narrated-demos login.
# DEMO_BASIC_AUTH_USER=
# DEMO_BASIC_AUTH_PASSWORD=
